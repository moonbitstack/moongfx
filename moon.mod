name = "moonbitstack/moongfx"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moongfx"

license = "Apache-2.0"

keywords = [
  "2d",
  "graphics",
  "canvas",
  "path",
  "tessellation",
  "triangulation",
  "stroke",
  "fill",
  "bezier",
  "arc",
  "antialiasing",
  "rasterizer",
  "software-renderer",
  "glyph",
  "atlas",
  "text",
  "gradient",
  "clipping",
  "gpu",
  "renderer",
]

description = "Two-dimensional drawing for MoonBit: paths, fill and stroke tessellation, glyph atlas and a software rasteriser."

source = "src"

import {
  "moonbitstack/moonimage@0.2.1",
  "moonbitstack/moonmath@0.2.1",
  "moonbitstack/moonrgba@0.2.1",
}
