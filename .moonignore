# `.gitignore` keeps `!.git*` so that .gitignore, .github and .gitattributes stay
# tracked; that same negation would otherwise pull the whole `.git` directory —
# object database included — into the published tarball.
.git/
_build/
target/

# Examples are read in the repository and run in CI; they do not ship.
src/examples/

# The conformance module compares against reference images; it is not part of
# what a user of the library downloads.
integration/
scripts/refs/target/
